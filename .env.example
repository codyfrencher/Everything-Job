DATABASE_URL="postgresql://housecall:housecall@localhost:5432/housecall?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Push notifications. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"

# Shared secret checked against the x-webhook-secret header on
# /api/webhooks/leadconnector. Generate with: openssl rand -hex 32
LEADCONNECTOR_WEBHOOK_SECRET="replace-with-a-random-secret"
