// Prisma schema for the Housecall-inspired team app.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DISPATCHER
  TECH
}

enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TECH)
  phone        String?
  createdAt    DateTime @default(now())

  jobAssignments   JobAssignment[]
  customersCreated Customer[] @relation("CustomerCreatedBy")
  jobPhotosUploaded JobPhoto[] @relation("JobPhotoUploadedBy")
  pushSubscriptions PushSubscription[]
}

model Customer {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String?
  street     String?
  city       String?
  state      String?
  zip        String?
  notes      String?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  // Set when this customer originated from an external CRM (e.g. a
  // LeadConnector contact ID) so repeat webhook deliveries update the
  // same customer instead of creating duplicates.
  externalId String? @unique

  createdById String?
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  jobs Job[]

  @@index([name])
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      JobStatus @default(UNSCHEDULED)

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  street String?
  city   String?
  state  String?
  zip    String?

  notes String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignments JobAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos JobPhoto[]

  @@index([status])
  @@index([scheduledStart])
}

model JobAssignment {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

model JobPhoto {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("JobPhotoUploadedBy", fields: [uploadedById], references: [id])

  @@index([jobId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  jobId     String?
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
